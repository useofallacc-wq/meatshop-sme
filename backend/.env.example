# Copy this file to ".env" in the same folder and fill in your real values.
# Find these in: Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use the SERVICE ROLE key (not the anon key) so the backend can bypass RLS
# and perform full CRUD. NEVER expose the service role key in the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Port the Flask API will run on
PORT=5000
